groups <- c("Endo", "HE", "HPC")
genes <- c("CDH5", "MYB", "PTPRC", "RUNX1")
cols <- c(Endo="#F8766D", HE="#00BA38", HPC="#619CFF")

obj <- subset(obj, subset = cell.type %in% groups)
Idents(obj) <- "cell.type"


da1 <- FindMarkers(obj, ident.1="HE", ident.2="Endo",
                   assay="ATAC", test.use="LR",
                   latent.vars="nCount_ATAC",
                   min.pct=0, logfc.threshold=0)

da2 <- FindMarkers(obj, ident.1="HPC", ident.2="HE",
                   assay="ATAC", test.use="LR",
                   latent.vars="nCount_ATAC",
                   min.pct=0, logfc.threshold=0)

summary_da <- function(x) {
  fc <- grep("^avg_log.*FC$", names(x), value=TRUE)[1]
  c(Gained=sum(x$p_val_adj<0.05 & x[[fc]]>0, na.rm=TRUE),
    Lost=sum(x$p_val_adj<0.05 & x[[fc]]<0, na.rm=TRUE))
}

da <- data.frame(
  transition=rep(c("Endo → HE","HE → HPC"), each=2),
  change=rep(c("Gained","Lost"), 2),
  count=c(summary_da(da1), summary_da(da2)),
  total=rep(c(nrow(da1), nrow(da2)), each=2)
)
da$percent <- 100*da$count/da$total

p_a <- ggplot(da, aes(transition, percent, fill=change)) +
  geom_col(position="dodge") +
  scale_fill_manual(values=c(Gained="#B2182B", Lost="#2166AC")) +
  theme_classic()

