    labels = c("HPC", "HE", "Endo", "Stroma")),
  pseudotime = sce$slingPseudotime_1
)

p <- ggplot(df, aes(pseudotime, celltype, color = celltype)) +
  geom_quasirandom(groupOnX = FALSE) +
