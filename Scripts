library(clusterProfiler)
library(org.Hs.eg.db)
library(enrichplot)


# Load data
obj <- readRDS("path/to/your/seurat.RDS")
DefaultAssay(obj) <- "RNA"
Idents(obj) <- "cell.type"

# GSEA analysis
comparisons <- list(
  Endo_vs_Stromal = c("2_Endo", "1_Stromal"),
  HE_vs_Endo = c("3_HE", "2_Endo"),
  HPC_vs_HE = c("4_HPC", "3_HE")
)

for (name in names(comparisons)) {
  groups <- comparisons[[name]]
  markers <- FindMarkers(obj, ident.1 = groups[1], ident.2 = groups[2])

  genes <- bitr(rownames(markers), fromType = "SYMBOL",
                toType = "ENSEMBL", OrgDb = org.Hs.eg.db)
  df <- merge(markers, genes, by.x = 0, by.y = "SYMBOL")
  ranks <- setNames(df$avg_log2FC, df$ENSEMBL)
  ranks <- sort(ranks[is.finite(ranks) & !duplicated(names(ranks))],
                decreasing = TRUE)

  gsea <- gseGO(ranks, OrgDb = org.Hs.eg.db,
                keyType = "ENSEMBL", ont = "ALL",
                minGSSize = 3, maxGSSize = 800,
                pvalueCutoff = 0.05, pAdjustMethod = "none",
                eps = 0)

  write.csv(as.data.frame(gsea), paste0(name, "_GSEA.csv"),
            row.names = FALSE)

  p <- dotplot(gsea, showCategory = 10, split = ".sign") +
    facet_grid(. ~ .sign) + theme_bw()

  ggsave(paste0(name, "_GSEA.pdf"), p, width = 8, height = 5)
}


