  p <- ggplot(df, aes(group, value, fill=group)) +
    geom_col(color="black") +
    geom_text(aes(label=round(value,2)), vjust=-0.4) +
    scale_fill_manual(values=cols) +
    labs(title=paste(length(idx),"called ATAC peaks"),
         x=NULL, y="Mean accessibility\nlog2(CPM + 1)") +
    theme_classic() +
    theme(legend.position="none")

  ggsave(paste0(gene,"_accessibility.pdf"), p, width=4, height=4)
}

