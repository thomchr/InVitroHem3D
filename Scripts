library(slingshot)
library(ggbeeswarm)

# Slingshot
sce <- as.SingleCellExperiment(subset(obj,
  idents = c("1_Stromal", "2_Endo", "3_HE", "4_HPC")))
reducedDim(sce, "UMAP") <- Embeddings(obj, "umap.rna")[colnames(sce), ]

sce <- slingshot(sce, clusterLabels = "cell.type",
  reducedDim = "UMAP", start.clus = "1_Stromal",
  end.clus = "4_HPC", shrink.method = "density", reweight = TRUE)

# Pseudotime plot
df <- data.frame(
  celltype = factor(sce$cell.type,
    levels = rev(c("1_Stromal", "2_Endo", "3_HE", "4_HPC")),
    labels = c("HPC", "HE", "Endo", "Stroma")),
  pseudotime = sce$slingPseudotime_1
)

p <- ggplot(df, aes(pseudotime, celltype, color = celltype)) +
  geom_quasirandom(groupOnX = FALSE) +
  scale_color_manual(values = c(
    Stroma = "gray", Endo = "orange",
    HE = "darkorange", HPC = "bisque")) +
  theme_classic() + theme(legend.position = "none") +
  labs(x = "Pseudotime", y = NULL)

ggsave("Slingshot_Pseudotime.pdf", p, width = 5, height = 4)


