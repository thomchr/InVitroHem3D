library(Signac)
library(JASPAR2020)
library(TFBSTools)
library(BSgenome.Hsapiens.UCSC.hg38)


# Load Seurat object
obj <- readRDS("path/to/your/seurat.RDS")
DefaultAssay(obj) <- "ATAC"
Idents(obj) <- "cell.type"

# Add motifs
pfm <- getMatrixSet(JASPAR2020, opts = list(
  collection = "CORE", tax_group = "vertebrates",
  all_versions = FALSE))
obj <- AddMotifs(obj, genome = BSgenome.Hsapiens.UCSC.hg38, pfm = pfm)

# Differential accessibility
da <- FindMarkers(obj, ident.1 = "1_Stromal",
                  ident.2 = "2_Endo", only.pos = TRUE,
                  test.use = "LR", min.pct = 0.05,
                  latent.vars = "nCount_ATAC")

# Motif enrichment
motifs <- FindMotifs(obj, features = rownames(da)[da$p_val < 0.005])
write.csv(motifs, "Stromal_vs_Endo_motifs.csv")

# Visualization
top20 <- head(motifs[order(-motifs$fold.enrichment), ], 20)

p <- ggplot(top20, aes(fold.enrichment,
                       reorder(motif.name, fold.enrichment))) +
  geom_point(aes(color = p.adjust, size = -log10(pvalue))) +
  theme_bw() +
  labs(x = "Fold enrichment", y = NULL)

ggsave("Stromal_vs_Endo_motifs.pdf", p, width = 5, height = 6)




