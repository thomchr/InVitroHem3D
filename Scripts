library(dplyr)
library(tidyr)
library(ggrepel)
library(ComplexHeatmap)
library(circlize)


obj <- readRDS("path/to/your/seurat.RDS")

# Motor gene modules
genes <- list(
  "Dynein" = c("DYNC2H1","DYNC1H1","DYNC1I2","DYNLL1"),
  "Dynactin / adaptors" = c("BICD1","HOOK3","PAFAH1B1","DCTN2"),
  "Transport kinesins" = c("KIF5B","KIF21A","KIF1B","KIF13B"),
  "Mitotic motors" = c("TPX2","CENPF","CENPE","KIF20B"),
  "MT dynamics" = c("TUBA1A","TUBB3","TUBB","TUBA1B"),
  "MT proteins" = c("MTUS1","CLIP1","MAP1B","MAP4"),
  "Polarity / transport" = c("PARD3","RAC1","CDC42","VCL")
)

# Balanced expression
stages <- c("1_Stromal","2_Endo","3_HE","4_HPC")
cells <- split(colnames(obj), as.character(obj$cell.type))
genes <- lapply(genes, intersect, y = rownames(obj[["RNA"]]))
g <- unlist(genes)
x <- GetAssayData(obj, assay = "RNA", layer = "data")[g, ]
n <- min(lengths(cells[stages]))

set.seed(12345)
mat <- sapply(stages, function(s) {
  replicate(100, Matrix::rowMeans(
    x[, sample(cells[[s]], n, replace = TRUE), drop = FALSE]
  )) |> apply(1, median)
})

z <- t(scale(t(mat)))
z[!is.finite(z)] <- 0

# Heatmap
pdf("Fig_A.pdf", 6, 9)
ComplexHeatmap::Heatmap(
  pmax(-2, pmin(2, z)),
  name = "Row z-score",
  col = circlize::colorRamp2(c(-2,0,2),
                             c("#5474AE","white","#D95C60")),
  row_split = factor(rep(names(genes), lengths(genes)),
                     levels = names(genes)),
  cluster_rows = FALSE, cluster_columns = FALSE,
  cluster_row_slices = FALSE,
  row_names_side = "right"
)



## 5b

modules <- genes[names(genes) != "MT proteins"]

y <- as.matrix(x[unlist(modules), unlist(cells[stages])])
z <- t(scale(t(y)))
z[!is.finite(z)] <- 0

scores <- sapply(modules, function(g)
  colMeans(z[g, , drop = FALSE]))

# Balanced bootstrap
set.seed(12345)
df <- dplyr::bind_rows(lapply(stages, function(s) {
  b <- replicate(500, colMeans(scores[
    sample(cells[[s]], n, replace = TRUE), , drop = FALSE]))
  data.frame(stage = s, module = colnames(scores),
             mean = rowMeans(b),
             lower = apply(b, 1, quantile, .025),
             upper = apply(b, 1, quantile, .975))
}))

df$stage <- factor(df$stage, levels = stages,
                   labels = c("Stroma", "Endo", "HE", "HPC"))
df$module <- factor(df$module, levels = names(modules))

# Plot
pB <- ggplot(df, aes(stage, mean, group = 1)) +
  geom_hline(yintercept = 0, linetype = 2, color = "grey80") +
  geom_line(color = "grey40") +
  geom_errorbar(aes(ymin = lower, ymax = upper), width = .08) +
  geom_point(aes(color = stage), size = 2.5) +
  facet_wrap(~module, ncol = 2) +
  scale_color_manual(values = c("#E7B06A","#D98A5F",
                                "#C85C5C","#8E3B56")) +
  theme_classic() +
  theme(legend.position = "none",
        axis.text.x = element_text(angle = 25, hjust = 1),
        strip.text = element_text(face = "bold")) +
  labs(x = NULL, y = "Module score")

ggsave("Fig_B.pdf", pB, width = 7, height = 7)


