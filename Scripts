library(SeuratWrappers)
library(monocle3)
library(dplyr)
library(dbscan)
library(igraph)


# Load Seurat object
obj <- readRDS("path/to/your/seurat.RDS")

stages <- c("1_Stromal", "2_Endo", "3_HE", "4_HPC")

stopifnot(
  "cell.type" %in% colnames(obj@meta.data),
  "SCT" %in% Assays(obj),
  "umap.rna" %in% Reductions(obj)
)

obj <- subset(obj, subset = cell.type %in% stages)
obj$cell.type <- factor(obj$cell.type, levels = stages)

# Use the existing RNA UMAP
DefaultAssay(obj) <- "SCT"
obj[["umap"]] <- CreateDimReducObject(
  embeddings = Embeddings(obj, "umap.rna"),
  key = "UMAP_",
  assay = "SCT"
)

# Monocle3 trajectory analysis
cds <- as.cell_data_set(obj, assay = "SCT", reduction = "umap")
colData(cds)$cell.type <- obj$cell.type[colnames(cds)]

cds <- cluster_cells(cds, reduction_method = "UMAP")

cds <- learn_graph(
  cds,
  use_partition = FALSE,
  close_loop = FALSE,
  learn_graph_control = list(
    minimal_branch_len = 20,
    euclidean_distance_ratio = 1,
    geodesic_distance_ratio = 1/3,
    orthogonal_proj_tip = TRUE,
    prune_graph = TRUE
  )
)

# Select the dominant stromal principal node as the root
v <- as.matrix(
  principal_graph_aux(cds)[["UMAP"]]$pr_graph_cell_proj_closest_vertex
)

nodes <- igraph::V(principal_graph(cds)[["UMAP"]])$name
cell_nodes <- as.character(v[, 1])

if (!all(cell_nodes %in% nodes)) {
  cell_nodes <- nodes[as.integer(cell_nodes)]
}

names(cell_nodes) <- rownames(v)
cell_nodes <- cell_nodes[colnames(cds)]

stromal_cells <- colnames(cds)[
  colData(cds)$cell.type == "1_Stromal"
]

root <- names(which.max(table(cell_nodes[stromal_cells])))

cds <- order_cells(
  cds,
  reduction_method = "UMAP",
  root_pr_nodes = root
)

# Check pseudotime distribution across cell types
pt <- pseudotime(cds)

print(tapply(
  pt[colnames(cds)],
  colData(cds)$cell.type,
  median,
  na.rm = TRUE
))

# Extract UMAP coordinates and pseudotime
um <- reducedDims(cds)$UMAP

df <- data.frame(
  UMAP1 = um[, 1],
  UMAP2 = um[, 2],
  pseudotime = pt[rownames(um)],
  celltype = as.character(colData(cds)$cell.type)
)

# DBSCAN filtering for visualization only
filter_umap <- function(d, eps, minPts) {
  if (nrow(d) < minPts * 3) return(d)

  r <- max(
    diff(range(d$UMAP1)),
    diff(range(d$UMAP2))
  )

  if (!is.finite(r) || r == 0) return(d)

  cl <- dbscan::dbscan(
    d[, c("UMAP1", "UMAP2")] / r,
    eps = eps,
    minPts = minPts
  )$cluster

  if (!any(cl > 0)) return(d)

  main <- as.integer(
    names(which.max(table(cl[cl > 0])))
  )

  d[cl == main, ]
}

# Retain all HE cells
plot_df <- bind_rows(
  filter_umap(filter(df, celltype == stages[1]), 0.035, 12),
  filter_umap(filter(df, celltype == stages[2]), 0.040, 8),
  filter(df, celltype == stages[3]),
  filter_umap(filter(df, celltype == stages[4]), 0.035, 10)
) %>%
  filter(is.finite(pseudotime))

# Plot pseudotime UMAP
