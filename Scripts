cols <- c(HE="#F8766D",HPC="#00BFC4")
expected <- setNames(c("HE","HE",rep("HPC",4)),genes)
regions <- c("chr16-66360000-66415000","chr4-55065000-55130000",
             "chr1-198600000-198690000","chr11-47345000-47390000",
             "chr6-135175000-135225000","chr21-35025000-35085000")


p <- Map(function(g,r)
  CoveragePlot(obj,region=r,group.by="ATAC_group",
               cols=cols,peaks=TRUE,annotation=TRUE,links=FALSE) +
    plot_annotation(title=paste(g,"locus")), genes,regions)
ggsave("Panel_C.pdf",wrap_plots(p,ncol=2),width=15,height=16)

##7b
x <- GetAssayData(obj,assay="ATAC",layer="counts")
pr <- granges(obj[["ATAC"]])
a <- Annotation(obj[["ATAC"]])
cpm <- sapply(c("HE","HPC"),function(g) {
  m <- x[,WhichCells(obj,idents=g),drop=FALSE]
  Matrix::rowSums(m)/sum(m)*1e6
})

df <- do.call(rbind,lapply(genes,function(g) {
  r <- range(a[a$gene_name==g])
  start(r) <- pmax(1,start(r)-20000)
  end(r) <- end(r)+20000
  i <- unique(subjectHits(findOverlaps(r,pr)))
  d <- log2(cpm[i,1]+1)-log2(cpm[i,2]+1)
  i <- i[if(expected[g]=="HE") d>0 else d<0]
  d <- log2(cpm[i,1]+1)-log2(cpm[i,2]+1)
  score <- pmax(cpm[i,1],cpm[i,2])
  pool <- which(score>=1 & abs(d)>=0.5)
  if(length(pool)<2) pool <- seq_along(i)
  k <- head(pool[order(d[pool],decreasing=expected[g]=="HE")],3)
  i <- i[k][order(start(pr[i[k]]))]
  data.frame(gene=g,peak=seq_along(i),
             HE=log2(cpm[i,1]+1),HPC=log2(cpm[i,2]+1))
}))

df$label <- factor(paste0(df$gene,"-P",df$peak),
                   levels=rev(paste0(df$gene,"-P",df$peak)))

ggplot(df) +
  geom_segment(aes(x=HE,xend=HPC,y=label,yend=label),color="grey75") +
  geom_point(aes(HE,label),color=cols["HE"],size=2.5) +
  geom_point(aes(HPC,label),color=cols["HPC"],size=2.5) +
  labs(x="log2(CPM + 1)",y=NULL) +
  theme_classic()

